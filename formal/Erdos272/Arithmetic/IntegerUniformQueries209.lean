def Domain (a : Query) : Prop := 31≤a.M ∧ a.M≤a.T ∧ 5*a.z≤4*a.M
def Cap (a : Query) : Prop :=
  a.q≤(a.z : ℚ)*(a.T-7*(a.M : ℚ)/25-1) ∨ a.q/a.z+7*(a.M : ℚ)/25+1≤1540096
instance (a : Query) : Decidable (Domain a) := by unfold Domain; infer_instance
instance (a : Query) : Decidable (Cap a) := by unfold Cap; infer_instance
instance (a : Query) : Decidable (Domain a ∧ Cap a) := instDecidableAnd

def certified (a : Query) : Bool := valid a && decide (Domain a ∧ Cap a)
def checked : Bool := queries.all certified

private theorem certified_append {xs ys : List Query}
    (hx : xs.all certified = true) (hy : ys.all certified = true) :
    (xs ++ ys).all certified = true := by
  simpa only [List.all_append, Bool.and_eq_true_iff] using And.intro hx hy

