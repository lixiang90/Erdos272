theorem query_sound {a : Query} (ha : a∈queries) :
    Domain a ∧ (a.q : ℝ)≤UniformScale208.Baseline a.T a.z a.M ∨
    Domain a ∧ UniformEnvelope208.HeightEnd a.M a.z a.q≤1540096 := by
  have hh : certified a=true := List.all_eq_true.mp checked_true a ha
  have hpair : valid a=true ∧ decide (Domain a ∧ Cap a)=true := by
    simpa only [certified,Bool.and_eq_true_iff] using hh
  have hdc : Domain a ∧ Cap a := of_decide_eq_true hpair.2
  rcases hdc.2 with hb | he
  · left
    refine ⟨hdc.1,?_⟩
    have hbR : (a.q : ℝ)≤(a.z : ℝ)*((a.T : ℝ)-7*(a.M : ℝ)/25-1) := by
      have hh := (Rat.cast_le (K := ℝ)).mpr hb
      simpa only [Rat.cast_mul,Rat.cast_sub,Rat.cast_div,Rat.cast_natCast,Rat.cast_ofNat,Rat.cast_one] using hh
    unfold UniformScale208.Baseline
    nlinarith only [hbR]
  · right
    refine ⟨hdc.1,?_⟩
    have heR : (a.q : ℝ)/(a.z : ℝ)+7*(a.M : ℝ)/25+1≤1540096 := by
      have hh := (Rat.cast_le (K := ℝ)).mpr he
      simpa only [Rat.cast_add,Rat.cast_mul,Rat.cast_div,Rat.cast_natCast,Rat.cast_ofNat,Rat.cast_one] using hh
    simpa only [UniformEnvelope208.HeightEnd] using heR

theorem decision {a : Query} (ha : a∈queries) : Decision (a.M : ℝ) a.T a.z a.q := by
  have hh : certified a=true := List.all_eq_true.mp checked_true a ha
  have hv : valid a=true := by
    have hp : valid a=true ∧ decide (Domain a ∧ Cap a)=true := by
      simpa only [certified,Bool.and_eq_true_iff] using hh
    exact hp.1
  simpa only [Rat.cast_natCast] using UniformDecision208.check_sound hv

theorem actual_bound {N : ℕ} {S : Finset ℤ} (a : Query) (ha : a∈queries)
    (hN : 2≤N) (hS : S⊆Ground N) (hT : a.T≤S.card) (hdef : a.z≤Defect S) :
    (a.q : ℝ)≤UniformCapacity208.JointMass N 1 a.M S := by
  have hs := query_sound ha
  have hd : Domain a := hs.elim And.left And.left
  have hm : (31 : ℝ)≤a.M := by exact_mod_cast hd.1
  have hmt : (a.M : ℝ)≤a.T := by exact_mod_cast hd.2.1
  have ht : (a.T : ℝ)≤S.card := by exact_mod_cast hT
  have hzcap : (a.z : ℝ)≤4*(a.M : ℝ)/5 := by
    have hh : (5 : ℝ)*a.z≤4*(a.M : ℝ) := by exact_mod_cast hd.2.2
    linarith only [hh]
  apply IntegerUniformSource209.actual_checked_height hN hS hm hmt ht (by positivity) hzcap
    (by exact_mod_cast hdef)
  · exact hs.elim (fun h=>Or.inl h.2) (fun h=>Or.inr h.2)
  · exact decision ha

