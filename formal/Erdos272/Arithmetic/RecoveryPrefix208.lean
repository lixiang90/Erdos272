def LogCap : ℝ := 47395326522386851/3519605000000000

theorem log_cap {N : ℕ} (hN : 1≤N) (hhigh : N≤705097) : Real.log N ≤ LogCap := by
  have hh := PrefixLog131.log_endpoint_upper (by decide : 0<grid) state_839 (by decide : 0<839)
    (by omega : 0<N) hhigh
  norm_num [grid,LogCap] at hh ⊢
  exact hh

def LogLeft (r : ℕ) : ℝ := match r with
  | 1 => (45747107015-16094379129 : ℝ)/10000000000
  | 2 => (49199806445-13862943615 : ℝ)/10000000000
  | _ => (55134284586-16094379129 : ℝ)/10000000000

theorem log_left1 : LogLeft 1 ≤ Real.log (97/5 : ℝ) := by
  have hlo := (PrefixLog131.log_bounds (by decide : 0<grid) PrefixTable131.state_97).1
  have hhi := (PrefixLog131.log_bounds (by decide : 0<grid) PrefixTable131.state_5).2
  rw [Real.log_div (by norm_num) (by norm_num)]
  norm_num [LogLeft,grid] at hlo hhi ⊢
  linarith only [hlo,hhi]

