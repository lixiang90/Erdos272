def Links (k : ℕ) (b : Fin 7) : Prop :=
    queryIndex k b < 311 ∧
    (SourceAtlas67702.demand (queryIndex k b)).lower ≤ (evalData (data k).row b).T ∧
    (SourceAtlas67702.demand (queryIndex k b)).defect ≤ (evalData (data k).row b).E ∧
    (data k).potential ≤ (SourceAtlas67702.demand (queryIndex k b)).target

