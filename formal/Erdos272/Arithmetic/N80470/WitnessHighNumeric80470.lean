structure Band where
  T : ℕ
  E : ℕ
  U : ℕ
  b2 : ℕ
  b3 : ℕ
  b5 : ℕ
  b7 : ℕ
  b11 : ℕ
  deriving DecidableEq

structure Row where
  high : ℕ
  steps : ℕ
  witness : ℕ
  cap : ℕ
  bands : List Band
  deriving DecidableEq

def band (r : Row) (b : Fin 7) : Band :=
  (r.bands[b.val]?).getD ⟨0,0,0,0,0,0,0,0⟩

def block (b : Band) (d : ℕ) : ℕ :=
  if d%2=0 then b.b2 else if d%3=0 then b.b3 else if d%5=0 then b.b5
  else if d%7=0 then b.b7 else b.b11

def count (q a b : ℕ) : ℕ := if a≤q then (q-a)/b+1 else 0
def tri (n : ℕ) : ℕ := n*(n-1)/2
def capped (q t e b c : ℕ) : ℕ :=
  let l := count q (t-e) b
  let o := min l (count q (c-e) b)
  c*o+((l-o)*(q+e)-b*(tri l-tri o))

def phase (n d t e b c : ℕ) : ℕ :=
  n%d*capped (n/d) t e b c+(d-n%d)*capped (n/d-1) t e b c

def legacy (n d t e b c : ℕ) : ℕ :=
  d*capped (n/d) t e b c-
    if t-e≤n/d ∧ (n/d-(t-e))%b=0 then (d-n%d)*min c t else 0

def base (n d t e b u w : ℕ) : ℕ :=
  if 2≤e ∧ 3≤b then phase n d t e b (min (u+b-3) w)
  else legacy n d t e b (min (u+b-3) w)

def bound (n d t e b u w : ℕ) : ℕ :=
  if e≤1 then 0 else
    let v := u+b-3
    let m := min ((v-1)/b+1) (count (n/d) (t-e) b)
    min (base n d t e b u v)
      (base n d t e b u w+w*m*(min v (n/d+e)-w))

def cost (n d : ℕ) (b : Band) (w : ℕ) : ℕ := bound n d b.T b.E (block b d) b.U w

def value (r : Row) : ℕ :=
  ∑ b : Fin 7, if (band r b).E≤1 then 0 else
    ∑ d ∈ Finset.Icc 1 r.steps, cost r.high d (band r b) r.witness

