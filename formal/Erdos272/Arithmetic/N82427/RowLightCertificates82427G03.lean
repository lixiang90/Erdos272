    t.p ∈ ({2,3,5,7,11} : Finset ℕ) ∧ ClassFastNumeric82427.check t.p (RampLength (row 12).low (At (row 12) (length (k:=12) (by decide)) b) t.p) t.count=true := by
  decide +kernel
#print axioms ramps12

