theorem scale_4727 : (84610457463/5000000000:ℝ)≤Real.log ((4727:ℝ)^2) ∧ Real.log ((4727:ℝ)^2)≤(21152615561/1250000000:ℝ) := by
  have h163 := log_bounds (by decide : 0<grid) state_163
  norm_num [grid] at h163
  have h29 := log_bounds (by decide : 0<grid) state_29
  norm_num [grid] at h29
  have he : Real.log ((4727:ℝ)^2)=2*(Real.log (29:ℝ)+Real.log (163:ℝ)) := by
    calc Real.log ((4727:ℝ)^2)=2*Real.log (4727:ℝ) := Real.log_pow _ _
         _=2*(Real.log (29:ℝ)+Real.log (163:ℝ)) := by
           rw [show (4727:ℝ)=(29:ℝ)*(163:ℝ) by norm_num]
           rw [Real.log_mul (by norm_num) (by norm_num)]
  rw [he]
  constructor <;> linarith only [h163.1,h163.2,h29.1,h29.2]

