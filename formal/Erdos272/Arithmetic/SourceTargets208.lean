def TailCheck : Bool := Targets.all fun row =>
  row.2.zipIdx.all fun be => decide
    (be.2 ≤ Cutoff ∧ 7*be.1 ≤ (Cutoff-be.2) * (be.2+1).choose 2)

theorem tail_check : TailCheck = true := by decide

theorem checked_tail_floor {row : ℕ × List ℕ} {b e s : ℕ}
    (hrow : row ∈ Targets) (hbe : (b,e) ∈ row.2.zipIdx)
    (hs : Cutoff ≤ s) (hhi : s < 2^50) : b ≤ physicalK s e := by
  have hr := List.all_eq_true.mp tail_check row hrow
  have hb := of_decide_eq_true (List.all_eq_true.mp hr (b,e) hbe)
  apply tail_floor (by norm_num [Cutoff] at hs; omega) hb.1 hs hhi hb.2

#print axioms tail_check
#print axioms checked_tail_floor
end JSP233.SourceTargets208
