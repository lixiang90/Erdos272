theorem table_recurrence : ∀ i : Fin 1537,
    tableMu i.val = if i.val = 0 then 0 else if i.val = 1 then 1 else
      if i.val.minFac ∣ i.val / i.val.minFac
      then 0 else -tableMu (i.val / i.val.minFac) := by
  decide +kernel

theorem quantized_bounds : ∀ i : Fin 1536,
    tableQuant (i.val + 1) * (i.val + 1 : ℤ)^2 ≤
      16777216 * tableMu (i.val + 1) := by
  decide +kernel

theorem quantized_sum : (∑ d ∈ Finset.Icc 1 1536, tableQuant d) = 10198875 := by
  decide +kernel

theorem moebius_minFac_rec (n : Nat) (hn : 2 ≤ n) :
    moebius n = if n.minFac ∣ n / n.minFac then 0 else -moebius (n / n.minFac) := by
  have hp : Nat.Prime n.minFac := Nat.minFac_prime (by omega)
  have hprod : n.minFac * (n / n.minFac) = n := Nat.mul_div_cancel' (Nat.minFac_dvd n)
  by_cases hd : n.minFac ∣ n / n.minFac
  · rw [if_pos hd]
    apply moebius_eq_zero_of_not_squarefree
    intro hsq
    have hsqdvd : n.minFac * n.minFac ∣ n := by
      simpa only [hprod] using (mul_dvd_mul_left n.minFac hd)
    exact (Nat.squarefree_iff_prime_squarefree.mp hsq n.minFac hp) hsqdvd
  · rw [if_neg hd]
    have hc : Nat.Coprime n.minFac (n / n.minFac) := hp.coprime_iff_not_dvd.mpr hd
    have hm := isMultiplicative_moebius.map_mul_of_coprime hc
    rw [hprod, moebius_apply_prime hp, neg_one_mul] at hm
    exact hm

theorem minFac_rec_unique (f : Nat → Int) (K : Nat) (h0 : f 0 = 0) (h1 : f 1 = 1)
    (hrec : ∀ n, 2 ≤ n → n ≤ K →
      f n = if n.minFac ∣ n / n.minFac then 0 else -f (n / n.minFac)) :
    ∀ n ≤ K, f n = moebius n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    by_cases hz : n = 0
    · subst n
      simpa using h0
    by_cases hone : n = 1
    · subst n
      simpa using h1
    have htwo : 2 ≤ n := by omega
    have hp : Nat.Prime n.minFac := Nat.minFac_prime hone
    have hsmall : n / n.minFac < n := Nat.div_lt_self (by omega) hp.one_lt
    rw [hrec n htwo hn, moebius_minFac_rec n htwo]
    split_ifs
    · rfl
    · rw [ih (n / n.minFac) hsmall (Nat.le_trans (Nat.le_of_lt hsmall) hn)]

theorem rational_lower (f q : ℕ → ℤ)
    (hbound : ∀ d ∈ Finset.Icc 1 1536,
      q d * (d : ℤ)^2 ≤ 16777216 * f d)
    (hsum : (∑ d ∈ Finset.Icc 1 1536, q d) = 10198875) :
    (607 / 1000 : ℚ) + 1 / 1536 <
      ∑ d ∈ Finset.Icc 1 1536, (f d : ℚ) / (d : ℚ)^2 := by
  have hterm : ∀ d ∈ Finset.Icc 1 1536,
      (q d : ℚ) / 16777216 ≤ (f d : ℚ) / (d : ℚ)^2 := by
    intro d hd
    have hdpos : 0 < (d : ℚ) := by
      exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one (Finset.mem_Icc.mp hd).1)
    have hcast : (q d : ℚ) * (d : ℚ)^2 ≤ 16777216 * (f d : ℚ) := by
      exact_mod_cast hbound d hd
    apply (div_le_div_iff₀ (by norm_num : (0 : ℚ) < 16777216)
      (sq_pos_of_pos hdpos)).mpr
    simpa [mul_comm] using hcast
  have htot := Finset.sum_le_sum hterm
  have hcastsum : (∑ d ∈ Finset.Icc 1 1536, (q d : ℚ)) = 10198875 := by
    exact_mod_cast hsum
  have hleft : (∑ d ∈ Finset.Icc 1 1536, (q d : ℚ) / 16777216) =
      10198875 / 16777216 := by
    simp_rw [div_eq_mul_inv]
    rw [← Finset.sum_mul, hcastsum]
  rw [hleft] at htot
  exact (by norm_num : (607 / 1000 : ℚ) + 1 / 1536 < 10198875 / 16777216).trans_le htot

theorem table_eq_moebius (n : ℕ) (hn : n ≤ 1536) : tableMu n = moebius n := by
  apply minFac_rec_unique tableMu 1536 (by decide +kernel) (by decide +kernel) ?_ n hn
  intro m hm hmK
  have h := table_recurrence ⟨m, Nat.lt_succ_iff.mpr hmK⟩
  simpa [show m ≠ 0 by omega, show m ≠ 1 by omega] using h

theorem actual_quantized_bounds (d : ℕ) (hd : d ∈ Finset.Icc 1 1536) :
    tableQuant d * (d : ℤ)^2 ≤ 16777216 * moebius d := by
  have hd1 : 1 ≤ d := (Finset.mem_Icc.mp hd).1
  have hdK : d ≤ 1536 := (Finset.mem_Icc.mp hd).2
  have h := quantized_bounds ⟨d - 1, by omega⟩
  have hcast : ((d - 1 : ℕ) : ℤ) + 1 = (d : ℤ) := by
    exact_mod_cast Nat.sub_add_cancel hd1
  simpa [Nat.sub_add_cancel hd1, hcast, table_eq_moebius d hdK] using h

/-- The finite constant is for the actual Mathlib Moebius function. -/
theorem actual_moebius_rational_lower :
    (607 / 1000 : ℚ) + 1 / 1536 <
      ∑ d ∈ Finset.Icc 1 1536, (moebius d : ℚ) / (d : ℚ)^2 := by
  exact rational_lower moebius tableQuant actual_quantized_bounds quantized_sum

theorem actual_moebius_rational_minus_tail :
    (607 / 1000 : ℚ) <
      (∑ d ∈ Finset.Icc 1 1536, (moebius d : ℚ) / (d : ℚ)^2) - 1 / 1536 := by
  linarith [actual_moebius_rational_lower]

theorem actual_moebius_real_lower :
    (607 / 1000 : ℝ) + 1 / 1536 <
      ∑ d ∈ Finset.Icc 1 1536, (moebius d : ℝ) / (d : ℝ)^2 := by
  have h := (Rat.cast_lt (K := ℝ)).mpr actual_moebius_rational_lower
  push_cast at h
  simpa only [Rat.cast_pow, Rat.cast_natCast] using h

theorem actual_moebius_real_minus_tail :
    (607 / 1000 : ℝ) <
      (∑ d ∈ Finset.Icc 1 1536, (moebius d : ℝ) / (d : ℝ)^2) - 1 / 1536 := by
  linarith [actual_moebius_real_lower]
