def query (i : ℕ) : Plan := (queries[i]?).getD ⟨0,0,0,0,0⟩

theorem checked : queries.all (fun q => decide (Conditions q)) = true := by decide +kernel

theorem conditions {i : ℕ} (hi : i < 150) : Conditions (query i) := by
  have hlen : queries.length = 150 := rfl
  have hb : i < queries.length := by omega
  have hm : query i ∈ queries := by
    simp only [query, List.getElem?_eq_getElem hb, Option.getD_some]
    exact List.getElem_mem hb
  exact of_decide_eq_true (List.all_eq_true.mp checked (query i) hm)

#print axioms checked
#print axioms conditions
