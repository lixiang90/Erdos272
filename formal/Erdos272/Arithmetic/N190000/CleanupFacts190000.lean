theorem fact00 : ChunkFacts (toRow data00.row) 1 data00.steps (toTotals data00.total) := by
  exact (CleanupSegments208.append_exact
    (CleanupSegments208.append_exact
      (CleanupFastSound208.check_sound CleanupChecks190000G00.checked0000)
      (CleanupFastSound208.check_sound CleanupChecks190000G00.checked0001)
      rfl rfl rfl)
    (CleanupSegments208.append_exact
      (CleanupFastSound208.check_sound CleanupChecks190000G00.checked0002)
      (CleanupFastSound208.check_sound CleanupChecks190000G00.checked0003)
      rfl rfl rfl)
    rfl rfl rfl)
#print axioms fact00

