def block (b : Band) (d : ℕ) : ℕ :=
  if 2 ∣ d then b.b2 else if 3 ∣ d then b.b3 else
    if 5 ∣ d then b.b5 else if 7 ∣ d then b.b7 else b.b11

def Count (q C B : ℕ) : ℕ := if C ≤ q then (q-C)/B+1 else 0
def Tri (n : ℕ) : ℕ := n*(n-1)/2
def WeightSum (q T E B V : ℕ) : ℕ :=
  let L := Count q (T-E) B
  let O := Count q (V-E) B
  V*O+((L-O)*(q+E)-B*(Tri L-Tri O))

def Closed (N d T E B V : ℕ) : ℕ :=
  N%d*WeightSum (N/d) T E B V+(d-N%d)*WeightSum (N/d-1) T E B V

def cost (N d : ℕ) (b : Band) : ℕ :=
  if b.E ≤ 1 then 0 else Closed N d b.T b.E (block b d) (b.U+block b d-3)

def band (r : Row) (b : Fin 7) : Band := (r.bands[b.val]?).getD ⟨0,0,0,0,0,0,0,0⟩

def value (r : Row) : ℕ := ∑ b : Fin 7, if (band r b).E ≤ 1 then 0 else
  ∑ d ∈ Finset.Icc 1 r.steps, cost r.high d (band r b)

