    (hsize : (demand i).lower ≤ S.card) (hdefect : (demand i).defect ≤ Defect S) :
    (demand i).target ≤ (Pool S).card := by
  have hp : Paid (demand i) := by
    rw [← reference_eq hi]
    exact (sourceReference i).actual
  exact hp hN hground hS hsize hdefect

