theorem query_layout : IntegerUniformQueries209.queries=windows.flatMap (fun w=>w.rows.flatMap (rowQueries w)) := by
  decide +kernel

def blockPrime (b : CleanupEval208.Band) (p : ℕ) : ℕ :=
  match p with | 2=>b.b2 | 3=>b.b3 | 5=>b.b5 | 7=>b.b7 | _=>b.b11
def BandFact (M e : ℕ) (b : CleanupEval208.Band) : Prop :=
  M≤b.T ∧ 1≤b.E ∧ b.E≤e ∧ b.T<b.U ∧
  ∀p∈([2,3,5,7,11] : List ℕ),let B:=blockPrime b p
    2≤B ∧ B≤b.T-b.E ∧ ((p-1)*(b.T-b.E+1-B)≥b.E ∨ p*B≤(p-1)*(b.T-b.E+1))
instance (M e : ℕ) (b : CleanupEval208.Band) : Decidable (BandFact M e b) := by
  unfold BandFact;infer_instance
def Facts (w : Window) (r : Row) : Prop :=
  31≤w.M ∧ 2≤r.e ∧ r.e<w.M ∧ r.bands.length=7 ∧
  (band r 0).T=w.M ∧ w.high<11*(band r 6).U ∧
  (∀b : Fin 7,BandFact w.M r.e (band r b)) ∧
  (∀j : Fin 6,(band r ⟨j.val,by omega⟩).U=(band r ⟨j.val+1,by omega⟩).T)
instance (w : Window) (r : Row) : Decidable (Facts w r) := by
  unfold Facts;infer_instance
def checked : Bool := windows.all (fun w=>w.rows.all (fun r=>decide (Facts w r)))
theorem checked_true : checked=true := by decide +kernel

theorem facts {w : Window} {r : Row} (hw : w∈windows) (hr : r∈w.rows) : Facts w r := by
  have h1 : w.rows.all (fun r=>decide (Facts w r))=true := List.all_eq_true.mp checked_true w hw
  exact of_decide_eq_true (List.all_eq_true.mp h1 r hr)

theorem band_mem {r : Row} (hl : r.bands.length=7) (b : Fin 7) : band r b∈r.bands := by
  have hb : b.val<r.bands.length := by rw [hl];exact b.isLt
  rw [band,List.getD_eq_getElem _ _ hb]
  exact List.getElem_mem hb

theorem query_mem {w : Window} {r : Row} (hw : w∈windows) (hr : r∈w.rows) (b : Fin 7) :
    query w r (band r b)∈IntegerUniformQueries209.queries := by
  rw [query_layout]
  apply List.mem_flatMap.mpr
  refine ⟨w,hw,List.mem_flatMap.mpr ⟨r,hr,?_⟩⟩
  exact List.mem_map.mpr ⟨band r b,band_mem (facts hw hr).2.2.2.1 b,rfl⟩

theorem cover {w : Window} {r : Row} (hf : Facts w r) {N n : ℕ}
    (hN : N≤w.high) (hn : w.M≤n) (hs : 11*n≤N) :
    ∃b : Fin 7,(band r b).T≤n ∧ n<(band r b).U := by
  have h0 := hf.2.2.2.2.1
  have hlast := hf.2.2.2.2.2.1
  have h01 := hf.2.2.2.2.2.2.2 ⟨0,by decide⟩
  have h12 := hf.2.2.2.2.2.2.2 ⟨1,by decide⟩
  have h23 := hf.2.2.2.2.2.2.2 ⟨2,by decide⟩
  have h34 := hf.2.2.2.2.2.2.2 ⟨3,by decide⟩
  have h45 := hf.2.2.2.2.2.2.2 ⟨4,by decide⟩
  have h56 := hf.2.2.2.2.2.2.2 ⟨5,by decide⟩
  change (band r 0).U=(band r 1).T at h01
  change (band r 1).U=(band r 2).T at h12
  change (band r 2).U=(band r 3).T at h23
  change (band r 3).U=(band r 4).T at h34
  change (band r 4).U=(band r 5).T at h45
  change (band r 5).U=(band r 6).T at h56
  by_cases h : n<(band r 0).U
  · exact ⟨0,by omega,h⟩
  by_cases h1 : n<(band r 1).U
  · exact ⟨1,by omega,h1⟩
  by_cases h2 : n<(band r 2).U
  · exact ⟨2,by omega,h2⟩
  by_cases h3 : n<(band r 3).U
  · exact ⟨3,by omega,h3⟩
  by_cases h4 : n<(band r 4).U
  · exact ⟨4,by omega,h4⟩
  by_cases h5 : n<(band r 5).U
  · exact ⟨5,by omega,h5⟩
  exact ⟨6,by omega,by omega⟩

def recipe {w : Window} {r : Row} {N k : ℕ} {psi : ℕ→ℝ}
    (hw : w∈windows) (hr : r∈w.rows) (hN : N≤w.high) (hh : psi (k+1)≤r.height) :
    IntegerUniformSystem209.Recipe N w.M r.e k psi where
  data:=band r
  query:=fun b=>query w r (band r b)
  query_mem:=query_mem hw hr
  query_M:=fun _=>rfl
  query_T:=fun _=>rfl
  query_E:=fun _=>rfl
  height:=fun _=>hh
  M_le:=fun b=>(facts hw hr).2.2.2.2.2.2.1 b |>.1
  E_le:=fun b=>(facts hw hr).2.2.2.2.2.2.1 b |>.2.2.1
  TU:=fun b=>(facts hw hr).2.2.2.2.2.2.1 b |>.2.2.2.1
  cover:=fun n hn hs=>cover (facts hw hr) hN hn hs
  physical:=by
    intro d hd b
    have hp := StepClass208.primeGate_range d
    have hp' : StepClass208.PrimeGate d∈([2,3,5,7,11] : List ℕ) := by simpa using hp
    have hh := ((facts hw hr).2.2.2.2.2.2.1 b).2.2.2.2 (StepClass208.PrimeGate d) hp'
    have hcases : StepClass208.PrimeGate d=2 ∨ StepClass208.PrimeGate d=3 ∨
        StepClass208.PrimeGate d=5 ∨ StepClass208.PrimeGate d=7 ∨ StepClass208.PrimeGate d=11 := by simpa using hp
    rcases hcases with hp' | hp' | hp' | hp' | hp'
    all_goals simpa only [CleanupEval208.block,blockPrime,hp'] using hh

