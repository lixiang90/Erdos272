def Mix (r n : Nat) : Nat := mixLookup r n
def Score : Nat → Nat → Int := ReflectedScore Mix Left
def Potential (r i : Nat) : Int := potentialLookup r i
def Suffix (r i : Nat) : Int := suffixLookup r i

structure Block (lo count : Nat) : Prop where
  countzero : ∀ r : Fin count, Mix (lo+r) 0 = 0
  countstep : ∀ r : Fin count, ∀ n : Fin 250,
    Mix (lo+r) (n+1) = Mix (lo+r) n + if MixPred (lo+r) n then 1 else 0
  majorize : ∀ r : Fin count, lo+(r:Nat) < 249 →
    ∀ h : Fin 251, Potential (lo+r) h ≤ Suffix (lo+r) h
  descending : ∀ r : Fin count, lo+(r:Nat) < 249 →
    ∀ h : Fin 250, Suffix (lo+r) (h+1) ≤ Suffix (lo+r) h
  step : ∀ r : Fin count, lo+(r:Nat) < 249 → ∀ h : Fin 251,
    Score (lo+r+1) h + Suffix (lo+r) h ≤ Potential (lo+r+1) h

theorem Block.row {lo count : Nat} (cert : Block lo count) (n : Fin count) :
    Block (lo+n) 1 := by
  have hz (r : Fin 1) : (r:Nat) = 0 := by omega
  constructor
  · intro r
    simpa only [hz r,Nat.add_zero] using cert.countzero n
  · intro r h
    simpa only [hz r,Nat.add_zero] using cert.countstep n h
  · intro r hr h
    simpa only [hz r,Nat.add_zero] using cert.majorize n (by simpa only [hz r,Nat.add_zero] using hr) h
  · intro r hr h
    simpa only [hz r,Nat.add_zero] using cert.descending n (by simpa only [hz r,Nat.add_zero] using hr) h
  · intro r hr h
    simpa only [hz r,Nat.add_zero] using cert.step n (by simpa only [hz r,Nat.add_zero] using hr) h

/-- Assemble independently checked rows without one large reduction. -/
theorem Block.ofRows {lo count : Nat}
    (rows : ∀ r : Fin count, Block (lo+r) 1) : Block lo count := by
  constructor
  · intro r
    simpa only [Nat.add_zero] using (rows r).countzero ⟨0, by decide⟩
  · intro r n
    simpa only [Nat.add_zero] using (rows r).countstep ⟨0, by decide⟩ n
  · intro r hr h
    simpa only [Nat.add_zero] using
      (rows r).majorize ⟨0, by decide⟩ (by simpa only [Nat.add_zero] using hr) h
  · intro r hr h
    simpa only [Nat.add_zero] using
      (rows r).descending ⟨0, by decide⟩ (by simpa only [Nat.add_zero] using hr) h
  · intro r hr h
    simpa only [Nat.add_zero] using
      (rows r).step ⟨0, by decide⟩ (by simpa only [Nat.add_zero] using hr) h

#print axioms Block.row
#print axioms Block.ofRows
